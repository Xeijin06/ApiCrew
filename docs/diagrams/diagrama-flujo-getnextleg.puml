@startuml diagrama-flujo-getnextleg

title CrewMobile API - Flujo: GetNextLeg (Endpoint Principal)

skinparam backgroundColor #FEFEFE
skinparam activityBackgroundColor #LightYellow
skinparam activityDiamondBackgroundColor #LightCyan
skinparam defaultFontSize 11

|#LightBlue|Crew Mobile App|
start
:Envía POST /api/FlightCrews/GetNextLeg
con { "Email": "user@copa.com" };

|#LightYellow|FlightCrewsController|
:Recibe request con Email;

if (MockedEmployees?) then (Sí)
	:Buscar empleado en BD
	por Email;
	if (Empleado encontrado?) then (No)
		:Retorna 400
		"002. Employee info error";
		stop
	else (Sí)
		:Obtiene EmployeeId
		desde BD;
	endif
else (No)
	|#LightGreen|GraphService|
	:Obtener token Azure AD
	(Client Credentials);
	:Consultar Microsoft Graph
	GET /users?$filter=mail eq '{email}';
	:Extraer EmployeeId
	del usuario;
	|#LightYellow|FlightCrewsController|
	if (Usuario encontrado?) then (No)
		:Retorna 400
		"002. Employee info error";
		stop
	else (Sí)
	endif
endif

:Obtener vuelos en las
próximas 24 horas
(GetFlightsInTheNext24Hours);

if (Vuelos disponibles?) then (No)
	:Retorna 400
	"003. No available flights";
	stop
else (Sí)
	:Seleccionar siguiente
	vuelo (índice i);
endif

|#Orange|Copa Airlines APIs|
fork
	:GetPassengerList
	(lista de pasajeros);
fork again
	:GetPrefer
	(lista de preferidos);
fork again
	:GetSSR
	(Special Service Requests);
fork again
	:GetCounts
	(conteos de comidas);
fork again
	:GetSeats
	(mapa de asientos);
end fork

|#LightYellow|FlightCrewsController|

if (FailOneServiceFailAllServices\n&& algún servicio falló?) then (Sí)
	:Retorna 400
	"004-008. Service error";
	stop
else (No)
	note right
		Si MockServices=true y un servicio
		falla, se usa MockHelper como fallback
	end note
endif

:GetAirportNames(i)
Resolver nombres de aeropuertos;

:GetNextNextLeg(i)
Obtener siguiente-siguiente leg;

:MakeSSRAndMealsCounts(i)
Calcular conteos SSR y comidas;

:UnifyPassangerListAndFixNames(i)
Unificar y corregir nombres;

:MakePreferredCounts(i)
Calcular conteos preferidos;

:GetBusinessCounts(i)
Calcular conteos business;

:SetRoll(i)
Asignar rol del tripulante;

:FixDescriptorsAndOrderBusinessAndPreferrredCounts()
Ordenar conteos con descriptores;

:MakeFinalResponse(i)
Construir NextLegResponse;

|#LightBlue|Crew Mobile App|
:Recibe NextLegResponse
(200 OK);
stop

@enduml
